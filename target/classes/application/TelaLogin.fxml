                              <Cursor fx:constant="DEFAULT" />
                           </cursor>
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnEntrar" mnemonicParsing="false" prefHeight="32.0" prefWidth="100.0" text="Entrar" textFill="WHITE">
