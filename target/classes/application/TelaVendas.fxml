                  <Insets bottom="15.0" top="10.0" />
               </GridPane.margin>
               <children>
                  <Label fx:id="lblNomeProduto" text="lblNomeProduto">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblValorProduto" text="lblValorProduto">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Cliente" />
                  <TextField fx:id="txtCliente" />
                  <Label layoutX="10.0" layoutY="10.0" text="CPF/CNPJ">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="txtCpf" layoutX="10.0" layoutY="28.0" />
               </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-border-width: 2 0 2 2; -fx-border-color: black; -fx-border-radius: 5 0 0 5;" GridPane.rowIndex="1">
               <children>
                  <Label text="Código do produto" />
                  <TextField fx:id="txtCodigo" alignment="CENTER" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-border-color: black; -fx-border-width: 2 0 2 0;" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label layoutX="20.0" layoutY="22.0" text="Categoria">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <SearchableComboBox fx:id="scmbCategoria" layoutX="20.0" layoutY="40.0" />
                  <Label layoutX="20.0" layoutY="27.0" text="Produto">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Label>
                  <SearchableComboBox fx:id="scmbProduto" layoutX="20.0" layoutY="45.0" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" style="-fx-border-color: black; -fx-border-width: 2 2 2 0; -fx-border-radius: 0 5 5 0;" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Quantidade" />
                  <TextField fx:id="txtQuantidade" alignment="CENTER" maxWidth="-Infinity" prefWidth="80.0" />
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="0.0">
                     <children>
                        <Button fx:id="btnAdicionar" minHeight="32.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="150.0" text="Adicionar">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <styleClass>
                              <String fx:value="botoesSalvar" />
                              <String fx:value="botoesPadrao" />
                           </styleClass>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
            <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="2" GridPane.rowIndex="5">
               <GridPane.margin>
                  <Insets top="10.0" />
               </GridPane.margin>
               <children>
                  <Label text="Total: ">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblTotal" layoutX="10.0" layoutY="10.0" text="lblTotal">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
               <children>
                  <Label text="Forma de pagamento" />
                  <ComboBox fx:id="cmbFormaPagamento" prefWidth="200.0" />
               </children>
               <GridPane.margin>
                  <Insets top="10.0" />
               </GridPane.margin>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="5">
               <children>
                  <Label text="Desconto" />
                  <HBox prefHeight="0.0" prefWidth="0.0">
                     <children>
                        <Label text="R$">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDescontoAbs" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="80.0" />
                        <Label text="  ou  " />
                        <TextField fx:id="txtDescontoPercent" layoutX="10.0" layoutY="10.0" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="80.0" />
                        <Label layoutX="10.0" layoutY="10.0" text="\%">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
               <children>
                  <Label text="Data" />
                  <Label fx:id="lblData" text="lblData">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblHora" layoutX="20.0" layoutY="28.0" text="lblHora">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
               <children>
                  <Label fx:id="lblParcelas" text="Número de parcelas" />
                  <Spinner fx:id="spnNumeroParcelas" prefWidth="70.0" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="2">
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
               <children>
                  <Label text="Vendedor" />
                  <Label fx:id="lblVendedor" text="lblVendedor">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="6">
               <children>
                  <Button fx:id="btnRemover" mnemonicParsing="false" prefHeight="32.0" prefWidth="150.0" text="Remover">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <styleClass>
                        <String fx:value="botoesExcluir" />
                        <String fx:value="botoesPadrao" />
                     </styleClass>
                  </Button>
               </children>
            </VBox>
         </children>
      </GridPane>
   </children>
</AnchorPane>
